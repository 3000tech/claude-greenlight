{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {"type": "command", "command": "bash \"$HOME/.claude/hooks/working-lock.sh\" set", "timeout": 2}
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {"type": "command", "command": "bash \"$HOME/.claude/hooks/working-lock.sh\" set", "timeout": 2}
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {"type": "command", "command": "bash \"$HOME/.claude/hooks/working-lock.sh\" clear", "timeout": 2}
        ]
      }
    ]
  }
}
